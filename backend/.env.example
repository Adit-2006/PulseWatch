# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pulsewatch

# Client / CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Data Retention (days) — controls CheckResult TTL index
RETENTION_DAYS=30

# Monitor Limits
MAX_MONITORS_PER_USER=50

# Authentication (JWT)
JWT_SECRET=your-secret-key-here-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Worker / Monitoring Engine
START_WORKER_IN_PROCESS=false
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=5
WORKER_LEASE_DURATION_MS=30000

# Alerting / Notification Providers
# Options: resend, smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=alerts@pulsewatch.dev
# Or SMTP configuration:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-password
WEBHOOK_TIMEOUT_MS=5000
