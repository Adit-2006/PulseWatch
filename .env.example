# ==============================================================================
# PulseWatch — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local Instance)
# For Atlas, use: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pulsewatch?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pulsewatch

# Client / CORS (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Data Retention (days) — controls CheckResult MongoDB TTL index
RETENTION_DAYS=30

# Rate & Capacity Limits
MAX_MONITORS_PER_USER=50

# Authentication (JWT Secret must be at least 32 characters)
JWT_SECRET=your-secure-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Worker / Monitoring Engine Scheduler
# Set to 'true' in unified deployments (e.g., Render free tier) to run scheduler in-process
START_WORKER_IN_PROCESS=false
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=5
WORKER_LEASE_DURATION_MS=30000

# Demo Outage Simulation Route
# When true, exposes /api/demo/probe, /api/demo/toggle, and /api/demo/status
ENABLE_DEMO_ROUTES=false

# Alerting / Notification Providers (email options: resend, smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=alerts@pulsewatch.dev

# Or SMTP Configuration:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-password

# Webhook Timeout (milliseconds)
WEBHOOK_TIMEOUT_MS=5000
